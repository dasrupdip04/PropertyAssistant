# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=property_assistant
POSTGRES_HOST_PORT=5432

# Application Settings
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/property_assistant
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/property_assistant_test
INVENTORY_PATH=/app/data/property_inventory.csv
ADMIN_TOKEN=secret-admin-token
MAX_REJECT_RATIO=0.25

# Gemini LLM Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_NLU_MODEL=
GEMINI_RESPONDER_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
NLU_THINKING_LEVEL=minimal
RESPONDER_THINKING_LEVEL=minimal
MAX_MESSAGE_CHARS=1000
DEBUG=false
